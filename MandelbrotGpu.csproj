<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.5.0</Version>
    <ApplicationIcon>Assets\Mandelbrot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Mandelbrot.ico" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="third_party\**\*.cs" />
    <!-- ComputeSharp provides the Direct3D 12 compute shader runtime. -->
    <!-- Keep the released generators/build assets, but use our patched runtime. -->
    <PackageReference Include="ComputeSharp" Version="3.2.0" ExcludeAssets="compile;runtime" />
    <ProjectReference Include="third_party\ComputeSharp.Runtime\ComputeSharp.Runtime.csproj" />
    <!-- The MPFR/GMP packages are used only for their native DLL payloads.
         Managed calls go through NativeMpfr.cs so the app is not tied to an
         obsolete managed wrapper API. -->
    <PackageReference Include="Math.Gmp.Native.NET" Version="2.0.0" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="Math.Mpfr.Native.NET" Version="2.0.0" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyMpfrNativeBinaries" AfterTargets="Build">
    <!-- Copy the native DLLs next to the executable for both Visual Studio F5
         and command-line builds. libmpfr-4.dll depends on libgmp-10.dll. -->
    <ItemGroup>
      <MpfrNativeBinary Include="$(PkgMath_Gmp_Native_NET)\output\x64\libgmp-10.dll" />
      <MpfrNativeBinary Include="$(PkgMath_Mpfr_Native_NET)\output\x64\libmpfr-4.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(MpfrNativeBinary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
