<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ComputeSharp</AssemblyName>
    <PackageId>ComputeSharp.Runtime.Patched</PackageId>
    <IsPackable>false</IsPackable>
    <RootNamespace>ComputeSharp</RootNamespace>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <Version>3.2.0</Version>
    <InformationalVersion>3.2.0+mandelbrot.waitfix.1.upstream.9a7c9e0</InformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\ComputeSharp\build\computesharp.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Match upstream's existing unsafe-interop warning suppression. -->
    <NoWarn>$(NoWarn);CS8500;CS0649;CA1060</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp.Core" Version="3.2.0" />
    <Compile Include="..\ComputeSharp\src\ComputeSharp\**\*.cs" Exclude="..\ComputeSharp\src\ComputeSharp\**\bin\**;..\ComputeSharp\src\ComputeSharp\**\obj\**" />
    <Compile Include="AssemblyAttributes.cs" />
    <EmbeddedResource Include="..\ComputeSharp\src\ComputeSharp\Properties\ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
  </ItemGroup>
  <Import Project="..\ComputeSharp\src\ComputeSharp.Win32.D3D12\ComputeSharp.Win32.D3D12.projitems" Label="Shared" />
</Project>
